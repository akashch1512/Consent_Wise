{
  "manifest_version": 3,
  "name": "ConsentWise AI",
  "version": "1.0.0",
  "description": "Intelligently detects financial consent actions and redirects for safe, informed agreement.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ConsentWise AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "offscreen",
    "microphone"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8000/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
