# ConsentWise backend — copy this file to `.env` and fill in the values.

# ── OpenAI (required) ────────────────────────────────────────────────────────
# Used for: summary/danger scoring, chat, quiz, document vision, TTS, and STT.
OPENAI_API_KEY=sk-...

# Optional model overrides (sensible defaults are used when unset):
# OPENAI_TEXT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_API_BASE=https://api.openai.com/v1   # e.g. an Azure/proxy gateway

# ── Postgres (optional) ──────────────────────────────────────────────────────
# Enables per-user persistence (profile + analysis history) via /api/users.
# Leave unset to disable persistence: /api/users returns 503, everything else
# keeps working. Tests use a throwaway SQLite file automatically.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/consentwise
